# Docker Compose 部署用环境变量模板。docker compose 会自动加载同目录的 .env。
# 用法（服务器上）：
#   cp .env.example .env
#   填入真实值后保存 —— .env 已在 backend/.gitignore 中，不会入库
#
# .env 是「可选的」：不创建也能 `docker compose up -d --build` 起服务，各变量取默认值
# （AI 降级为规则桩、验证码接口返回 50300）。要让 AI 与邮箱注册真正可用，必须在此填入真实值。

# 数据库口令：必须与 docker-compose.yml 里 postgres 服务的 POSTGRES_PASSWORD 一致
DB_PASSWORD=1234

# Redis 口令：compose 内置的 redis 未开启认证，留空即可（留空也要保留这一行）
REDIS_PASSWORD=

# DeepSeek API Key：生产必需。缺失不会报错，但对话意图分析会静默降级为规则桩
DEEPSEEK_API_KEY=sk-your-real-key

# 通义千问 API Key（可选）：DeepSeek 失败时的兜底模型；缺省时直接走模板降级
DASHSCOPE_API_KEY=sk-your-dashscope-key

# QQ 邮箱 SMTP：用于发送注册验证码。缺失时验证码接口返回 50300，邮箱注册不可用
QQ_MAIL_USERNAME=you@qq.com
QQ_MAIL_AUTH_CODE=your-smtp-auth-code

# 允许跨域的前端来源，逗号分隔。
# 若前端与接口同源（nginx 反代 /api），浏览器不触发跨域，此项不影响
CORS_ALLOWED_ORIGINS=https://your-domain.com

# 转链签名密钥（FR-8）。建议配置一个随机长字符串；
# 未配置时使用进程内随机密钥，服务重启后旧转链全部失效
LINK_SIGNING_SECRET=change-me-to-a-long-random-secret

# 离线攻略包目录（FR-9）。默认值见 docker-compose.yml，对应命名卷 offline-packs
OFFLINE_PACK_DIR=/app/data/offline-packs

# 分享页公开地址（FR-12）。分享链接由该地址拼出，生产应填真实前端域名
SHARE_BASE_URL=https://your-domain.com
# 分享有效期（天）；0 表示永不过期
SHARE_EXPIRE_DAYS=30
# 可选：二维码图片模板，使用 {url} 占位；留空则接口返回 qrcodeUrl=null
SHARE_QRCODE_URL_TEMPLATE=

# 运营/达人白名单（FR-6 / FR-7 / FR-13），逗号分隔用户 ID；留空时仅 L3 用户可访问
ADMIN_USER_IDS=

# 达人分成比例（FR-13），默认 0.2；由服务端写入发布记录，请求体不接受该字段
EXPERT_COMMISSION_RATE=0.2

# 实时价格源（FR-6，可选）。未配置时机票/酒店数据块标记 unavailable，绝不编造价格。
# 数据源需返回 JSON：{"min":1000,"max":1500,"currency":"CNY","freshness":"2026-10-20T00:00:00Z"}
FLIGHT_PRICE_URL=
HOTEL_PRICE_URL=
PRICE_SOURCE_TOKEN=
